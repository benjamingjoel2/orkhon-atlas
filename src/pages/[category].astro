---
import Listing from '../components/Listing.astro';
import { CATEGORIES, DESTINATIONS } from '../lib/site';
import { getPosts } from '../lib/posts';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.slug }, props: { c } }));
}
const { c } = Astro.props as { c: (typeof CATEGORIES)[number] };
const all = await getPosts();
const posts = all.filter((p) => p.data.category === c.slug);
const photoFor: Record<string, string> = { destinations: 'gobi', 'nomad-life': 'nomad-life', festivals: 'naadam', 'horses-adventure': 'horses-adventure', itineraries: 'itinerary', 'travel-tips': 'travel-tips' };
---
<Listing title={c.name} intro={c.blurb} path={`/${c.slug}/`} crumbs={[{ name: 'Home', path: '/' }, { name: c.name, path: `/${c.slug}/` }]} posts={posts} ogPhoto={photoFor[c.slug]} section={c.slug}>
  {c.slug === 'destinations' && (
    <nav aria-label="Destinations" class="dest-nav">
      <h2 class="vh">Choose a destination</h2>
      <ul>
        {DESTINATIONS.map((d) => (
          <li><a href={`/destinations/${d.slug}/`}>{d.name}</a> <span>{d.blurb}</span></li>
        ))}
      </ul>
    </nav>
  )}
</Listing>
<style>
  .dest-nav ul { list-style: none; padding: 0; margin: 0 0 2rem; display: grid; gap: 0.75rem 1.5rem; }
  @media (min-width: 48rem) { .dest-nav ul { grid-template-columns: repeat(2, 1fr); } }
  .dest-nav li { border-top: 1px solid var(--line); padding-top: 0.6rem; }
  .dest-nav a { font-family: var(--serif); font-weight: 600; font-size: 1.2rem; }
  .dest-nav span { display: block; color: var(--muted); font-size: 0.95rem; }
</style>
